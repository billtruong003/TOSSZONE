# Unity generated / caches
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Visual Studio / Rider / IDE
.vs/
.vscode/
.idea/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# Packaged asset bundles
/[Aa]ssets/[Aa]ssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*

# OS
.DS_Store
Thumbs.db

# Paid Asset Store assets — NOT redistributed publicly (re-import from the Asset Store after cloning)
/[Aa]ssets/AutoHand/
/[Aa]ssets/AutoHand.meta

# Unity auto-generated crash/scene recovery (local only)
/[Aa]ssets/_Recovery/
/[Aa]ssets/_Recovery.meta

# Owner's proprietary shader kit — resolved via the UPM git dependency in manifest.json (self-heals on clone).
# This ignore only covers an OPTIONAL local embed of the same package under Packages/ (for in-place shader editing);
# the embedded copy is never committed (proprietary; this repo is public). Fresh clones get it from the git dependency.
# WARNING (Session 11 incident): if you embed, the copy MUST come from a clone of the kit repo WITH its original
# .meta files. An export/re-import creates fresh GUIDs -> every committed material that uses kit shaders breaks
# (this exact mistake caused the "pink materials after pull" bug). Also note: embedding flips packages-lock.json
# to "source": "embedded" — revert that hunk before committing, or other machines churn the lock.
/[Pp]ackages/com.billtruong.stylized-toon-world-kit/
/[Aa]ssets/StylizedToonWorldKit/
/[Aa]ssets/StylizedToonWorldKit.meta

# Local Meta XR embeds (downloaded as tarballs to work around UnityTls failing the Oculus registry).
# Pinned to 81.0.1 so the Meta XR Simulator works; not committed (large native libs, machine-local workaround).
/[Pp]ackages/com.meta.xr.sdk.core/
/[Pp]ackages/com.meta.xr.simulator/

# Claude Code Unity MCP config — machine-specific absolute uvx path; recreate per machine (template in HANDOFF).
/.mcp.json

# Temp / regenerated (not source): IDE local history + Unity-MCP runtime logs.
/.lh/
/[Aa]ssets/UnityMCP/Log/

# Meta Immersive Debugger (DevAgent) — auto-generated LAN debug token, regenerated each session (machine-local secret).
# The .meta must be ignored too: a tracked meta whose asset is ignored is an orphan on other machines —
# Unity deletes it there, then regenerates it here with a NEW GUID -> endless churn.
/[Aa]ssets/[Rr]esources/DevAgentSettings.asset
/[Aa]ssets/[Rr]esources/DevAgentSettings.asset.meta

# Photon Fusion sample-package archives (downloaded per machine via the Fusion menu; big, redistributable from Photon).
/[Aa]ssets/[Pp]hoton/FusionDemos/
/[Aa]ssets/[Pp]hoton/FusionDemos.meta
/[Aa]ssets/[Pp]hoton/FusionMenu/
/[Aa]ssets/[Pp]hoton/FusionMenu.meta

# Native build temp (CMake RelWithDebInfo / tools) — local build artifacts.
/.utmp/
